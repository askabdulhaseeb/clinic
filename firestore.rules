rules_version = '2';

// Firestore security rules. Summary table: docs/FIREBASE_ARCHITECTURE.md §6.
// Collections are opened per build phase (docs/DEVELOPMENT_PLAN.md §6);
// anything without an explicit match stays denied by the catch-all below.
//
// Phase 1: role helpers + `users`.
// Phase 2: `branches`, `settings`, `departments`, `visitTypes`, `doctors`.
// Phase 3: `families`, `patients` (`counters` stays Functions-only).
// Phase 4: `visits`.
// Phase 5A: `prescriptions`, `appointments`.
// Phase 5B: `reports`, `operations`; doctors edit visit-type defaults.
// Phase 7: `inventoryItems`, `stockMovements`, `suppliers`, `purchases`, `expenses`, `sales`.
// Phase 8A: `expenses` corrections, `dailySummaries` (Admin read), `summaryEvents` (closed).
// Phase 8B: `visits` corrections need an editReason, `payouts`.
// Phase 9: `auditLogs` (Admin read).
service cloud.firestore {
  match /databases/{database}/documents {

    // ----- helpers -----------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Roles live in Auth custom claims, not in the users document.
    // Missing claim resolves to an empty list so `in` checks simply fail.
    function roles() {
      return isSignedIn() ? request.auth.token.get('roles', []) : [];
    }

    function hasRole(r) {
      return isSignedIn() && (r in roles());
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isReception() {
      return hasRole('reception');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isOwnDoctor(doctorId) {
      return isDoctor() && request.auth.token.get('doctorId', null) == doctorId;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function updatedByIsCaller() {
      return request.resource.data.updatedBy == request.auth.uid;
    }

    // ----- users/{uid}  (§4.3) -------------------------------------------
    // Created and role-managed only by Cloud Functions (admin SDK bypasses
    // rules). Admin may rename; the user may clear mustChangePassword.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if false;
      allow update: if
        (isAdmin()
          && changedKeys().hasOnly(['displayName', 'updatedAt', 'updatedBy'])
          && updatedByIsCaller())
        ||
        (isOwner(uid)
          && changedKeys().hasOnly(['mustChangePassword', 'updatedAt', 'updatedBy'])
          && request.resource.data.mustChangePassword == false
          && updatedByIsCaller());
      allow delete: if false;
    }

    function createdByIsCaller() {
      return request.resource.data.createdBy == request.auth.uid;
    }

    function inCallerBranch(branchId) {
      return branchId in request.auth.token.get('branchIds', ['main']);
    }

    function isNonEmptyString(v) {
      return v is string && v.size() > 0;
    }

    // ----- master data (§4.1, §4.2, §4.4, §4.5, §4.6) ---------------------
    // Any signed-in user reads (reception caches all of it offline). Only
    // Admin writes, never deletes; inactive records keep `active: false`.
    // Audit of fee changes is a Phase 9 trigger.
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && createdByIsCaller();
      allow update: if isAdmin() && updatedByIsCaller();
      allow delete: if false;
    }

    match /settings/{settingsId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.clinicName)
        && updatedByIsCaller();
      allow update: if isAdmin()
        && isNonEmptyString(request.resource.data.clinicName)
        && updatedByIsCaller();
      allow delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.code)
        && request.resource.data.active is bool
        && createdByIsCaller();
      allow update: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.code)
        && request.resource.data.active is bool
        && updatedByIsCaller();
      allow delete: if false;
    }

    match /visitTypes/{visitTypeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.departmentId)
        && request.resource.data.isOperation is bool
        && request.resource.data.isFollowUp is bool
        && request.resource.data.active is bool
        && createdByIsCaller();
      allow update: if
        (isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.departmentId)
        && request.resource.data.isOperation is bool
        && request.resource.data.isFollowUp is bool
        && request.resource.data.active is bool
        && updatedByIsCaller())
        ||
        // Phase 5B: doctors maintain the defaults of operation types.
        (isDoctor()
          && resource.data.isOperation == true
          && changedKeys().hasOnly(['defaultPreOpChecklist', 'defaultPostOpDays', 'updatedAt', 'updatedBy'])
          && request.resource.data.defaultPreOpChecklist is list
          && request.resource.data.defaultPostOpDays is list
          && updatedByIsCaller());
      allow delete: if false;
    }

    match /doctors/{doctorId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.departmentId)
        && request.resource.data.salary is int
        && request.resource.data.salary >= 0
        && request.resource.data.sharePercent is number
        && request.resource.data.sharePercent >= 0
        && request.resource.data.sharePercent <= 100
        && request.resource.data.shareBasis in ['gross', 'net']
        && request.resource.data.fees is map
        && request.resource.data.active is bool
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      // `userId` is the login link and belongs to the user-management
      // functions (createUser / setUserRoles), not to the doctor form.
      allow update: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.departmentId)
        && request.resource.data.salary is int
        && request.resource.data.salary >= 0
        && request.resource.data.sharePercent is number
        && request.resource.data.sharePercent >= 0
        && request.resource.data.sharePercent <= 100
        && request.resource.data.shareBasis in ['gross', 'net']
        && request.resource.data.fees is map
        && request.resource.data.active is bool
        && !changedKeys().hasAny(['userId', 'branchId', 'createdAt', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    function isReceptionOrAdmin() {
      return isReception() || isAdmin();
    }

    // ----- families/{familyId}  (§4.7) ------------------------------------
    // Reception and Admin write; `duplicatePhone` is set by the
    // checkDuplicateFamilyPhone trigger only. Soft delete, never hard.
    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isReceptionOrAdmin()
        && isNonEmptyString(request.resource.data.phone)
        && isNonEmptyString(request.resource.data.headName)
        && request.resource.data.patientCount is int
        && request.resource.data.duplicatePhone == false
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isReceptionOrAdmin()
        && isNonEmptyString(request.resource.data.phone)
        && isNonEmptyString(request.resource.data.headName)
        && request.resource.data.patientCount is int
        && !changedKeys().hasAny(['duplicatePhone', 'branchId', 'createdAt', 'createdAtLocal', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- patients/{patientId}  (§4.8) -----------------------------------
    // `patientNo` is handed out by assignPatientNo; the client creates with
    // null and may never change it or the temp number.
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow create: if isReceptionOrAdmin()
        && request.resource.data.patientNo == null
        && isNonEmptyString(request.resource.data.tempNo)
        && isNonEmptyString(request.resource.data.familyId)
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.phones is list
        && request.resource.data.searchKeys is list
        && request.resource.data.visitCount is int
        && request.resource.data.deleted is bool
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isReceptionOrAdmin()
        && isNonEmptyString(request.resource.data.familyId)
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.gender in ['male', 'female', 'other']
        && request.resource.data.phones is list
        && request.resource.data.deleted is bool
        && !changedKeys().hasAny(['patientNo', 'tempNo', 'branchId', 'createdAt', 'createdAtLocal', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- visits/{visitId}  (§4.11) --------------------------------------
    // Reception and Admin create (shape checked, price consistent). Status
    // moves by reception and the assigned doctor (decided 4 Nov 2026); the
    // doctor also sets hasPrescription. Admin edits anything else; stamps
    // and branch never change. Soft delete needs a reason.
    function visitStatusValid(v) {
      return v.status in ['waiting', 'inProgress', 'completed'];
    }

    function visitPriceValid(v) {
      return v.fee is int && v.fee >= 0
        && v.discountAmount is int
        && v.discountAmount >= 0
        && v.discountAmount <= v.fee
        && v.netAmount is int
        && v.netAmount == v.fee - v.discountAmount
        && (v.discountAmount == 0 || isNonEmptyString(v.discountReason));
    }

    function visitShapeValid(v) {
      return isNonEmptyString(v.patientId)
        && isNonEmptyString(v.patientName)
        && isNonEmptyString(v.doctorId)
        && isNonEmptyString(v.doctorName)
        && isNonEmptyString(v.departmentId)
        && isNonEmptyString(v.visitTypeId)
        && isNonEmptyString(v.visitTypeName)
        && isNonEmptyString(v.tokenLabel)
        && v.token is int && v.token >= 1
        && isNonEmptyString(v.date)
        && v.paymentMethod in ['cash', 'bank', 'jazzcash', 'easypaisa']
        && v.receiptCopies is int
        && v.receiptCopies >= 1
        && v.receiptCopies <= 5
        && visitStatusValid(v)
        && visitPriceValid(v);
    }

    function statusOnlyChange(allowed) {
      return changedKeys().hasOnly(allowed.concat(['updatedAt', 'updatedBy']))
        && visitStatusValid(request.resource.data)
        && updatedByIsCaller();
    }

    match /visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isReceptionOrAdmin()
        && visitShapeValid(request.resource.data)
        && request.resource.data.status == 'waiting'
        && request.resource.data.deleted == false
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      // Phase 8B corrections (decided 6 Nov 2026): a change to the price,
      // payment or doctor needs an editReason; the department is locked so
      // the doctor can only move within it (token label and buckets stay).
      allow update: if
        (isAdmin()
          && visitShapeValid(request.resource.data)
          && request.resource.data.deleted is bool
          && (request.resource.data.deleted == false
              || isNonEmptyString(request.resource.data.deleteReason))
          && !changedKeys().hasAny(['branchId', 'createdAt', 'createdAtLocal', 'createdBy', 'departmentId', 'departmentCode'])
          && (!changedKeys().hasAny(['fee', 'discountAmount', 'discountReason', 'netAmount', 'paymentMethod', 'paymentRef', 'doctorId', 'doctorName'])
              || isNonEmptyString(request.resource.data.editReason))
          && updatedByIsCaller())
        ||
        (isReception()
          && statusOnlyChange(['status', 'startedAt', 'completedAt']))
        ||
        (isOwnDoctor(resource.data.doctorId)
          && statusOnlyChange(['status', 'startedAt', 'completedAt', 'hasPrescription']));
      allow delete: if false;
    }

    // ----- prescriptions/{visitId}  (§4.12) -------------------------------
    // Written only by the doctor of the visit (claim doctorId == the visit's
    // doctorId, one get). ID = visitId, date = the visit's date. Editable
    // until the end of the prescription's Karachi day (decided 5 Nov 2026):
    // `date` + 1 day at 00:00 Karachi is `date` 19:00 UTC.
    function visitOf(visitId) {
      return get(/databases/$(database)/documents/visits/$(visitId)).data;
    }

    function beforeEndOfKarachiDay(date) {
      return request.time < timestamp.date(
          int(date.split('-')[0]),
          int(date.split('-')[1]),
          int(date.split('-')[2])
        ) + duration.value(19, 'h');
    }

    match /prescriptions/{visitId} {
      allow read: if isSignedIn();
      allow create: if isDoctor()
        && request.resource.data.visitId == visitId
        && isNonEmptyString(request.resource.data.patientId)
        && isNonEmptyString(request.resource.data.date)
        && isOwnDoctor(request.resource.data.doctorId)
        && isOwnDoctor(visitOf(visitId).doctorId)
        && request.resource.data.date == visitOf(visitId).date
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isOwnDoctor(resource.data.doctorId)
        && beforeEndOfKarachiDay(resource.data.date)
        && !changedKeys().hasAny(['visitId', 'patientId', 'doctorId', 'departmentId', 'date', 'branchId', 'createdAt', 'createdAtLocal', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- appointments/{appointmentId}  (§4.10) ---------------------------
    // Reception, doctors and Admin book and change; follow-ups are written
    // by the prescription batch. Never deleted (cancelled instead).
    function isStaff() {
      return isReception() || isDoctor() || isAdmin();
    }

    function appointmentShapeValid(a) {
      return isNonEmptyString(a.patientId)
        && isNonEmptyString(a.patientName)
        && isNonEmptyString(a.doctorId)
        && isNonEmptyString(a.date)
        && a.status in ['booked', 'arrived', 'cancelled', 'noShow']
        && a.source in ['manual', 'followUp', 'postOp', 'operation']
        // Phase 6A: Arrived comes from the visit batch with the visit id.
        && (a.status != 'arrived' || isNonEmptyString(a.visitId));
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn();
      allow create: if isStaff()
        && appointmentShapeValid(request.resource.data)
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isStaff()
        && appointmentShapeValid(request.resource.data)
        && !changedKeys().hasAny(['branchId', 'createdAt', 'createdAtLocal', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- reports/{reportId}  (§4.13) ------------------------------------
    // Reception and Admin upload (file first, record second) and may rename
    // or soft-delete with a reason. File fields never change.
    function reportShapeValid(r) {
      return isNonEmptyString(r.patientId)
        && isNonEmptyString(r.title)
        && isNonEmptyString(r.storagePath)
        && r.mimeType in ['application/pdf', 'image/jpeg', 'image/png']
        && r.sizeBytes is int
        && r.sizeBytes > 0
        && r.sizeBytes <= 10 * 1024 * 1024;
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isReceptionOrAdmin()
        && reportShapeValid(request.resource.data)
        && request.resource.data.deleted == false
        && request.resource.data.uploadedBy == request.auth.uid
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isReceptionOrAdmin()
        && changedKeys().hasOnly(['title', 'deleted', 'deletedAt', 'deletedBy', 'deleteReason', 'updatedAt', 'updatedBy'])
        && isNonEmptyString(request.resource.data.title)
        && (request.resource.data.deleted == false
            || isNonEmptyString(request.resource.data.deleteReason))
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- operations/{operationId}  (§4.14) ------------------------------
    // Doctors and Admin schedule and manage; reception may only change the
    // post-op days (and the appointment ids the regeneration writes).
    function operationShapeValid(o) {
      return isNonEmptyString(o.patientId)
        && isNonEmptyString(o.visitTypeId)
        && isNonEmptyString(o.surgeonDoctorId)
        && isNonEmptyString(o.scheduledDate)
        && o.status in ['scheduled', 'done', 'cancelled']
        && o.checklist is list
        && o.postOpDays is list;
    }

    function operationStatusValid(o) {
      return (o.status != 'done'
              || (isNonEmptyString(o.doneBy)
                  && (o.checklistComplete == true
                      || isNonEmptyString(o.checklistOverrideReason))))
        && (o.status != 'cancelled' || isNonEmptyString(o.cancelReason));
    }

    function isDoctorOrAdmin() {
      return isDoctor() || isAdmin();
    }

    match /operations/{operationId} {
      allow read: if isSignedIn();
      allow create: if isDoctorOrAdmin()
        && operationShapeValid(request.resource.data)
        && request.resource.data.status == 'scheduled'
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if
        (isDoctorOrAdmin()
          && operationShapeValid(request.resource.data)
          && operationStatusValid(request.resource.data)
          && !changedKeys().hasAny(['branchId', 'createdAt', 'createdAtLocal', 'createdBy'])
          && updatedByIsCaller())
        ||
        (isReception()
          && changedKeys().hasOnly(['postOpDays', 'followUpAppointmentIds', 'updatedAt', 'updatedBy'])
          && request.resource.data.postOpDays is list
          && updatedByIsCaller());
      allow delete: if false;
    }

    // ----- inventoryItems/{itemId}  (§4.15, Phase 7A) ----------------------
    // Admin manages items; Reception may only move `stock` (the sale batch
    // decrements it). A lens item's ID is its lensKey.
    function isNonNegativeInt(v) {
      return v is int && v >= 0;
    }

    function itemShapeValid(i, itemId) {
      return i.category in ['medicine', 'frame', 'lens', 'consumable']
        && isNonEmptyString(i.name)
        && isNonNegativeInt(i.purchasePrice)
        && isNonNegativeInt(i.salePrice)
        && i.stock is int
        && isNonNegativeInt(i.lowStockThreshold)
        && i.active is bool
        && (i.category != 'lens' || (i.lens is map && i.lensKey == itemId));
    }

    match /inventoryItems/{itemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin()
        && itemShapeValid(request.resource.data, itemId)
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if
        (isAdmin()
          && itemShapeValid(request.resource.data, itemId)
          && !changedKeys().hasAny(['branchId', 'createdAt', 'createdBy'])
          && updatedByIsCaller())
        ||
        (isReception()
          && changedKeys().hasOnly(['stock', 'updatedAt', 'updatedBy'])
          && request.resource.data.stock is int
          && updatedByIsCaller());
      allow delete: if false;
    }

    // ----- stockMovements/{movementId}  (§4.18) ---------------------------
    // Append-only ledger written inside the purchase, sale and adjustment
    // batches. Admin reads the history; nobody edits it.
    match /stockMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isReceptionOrAdmin()
        && isNonEmptyString(request.resource.data.itemId)
        && request.resource.data.qty is int
        && request.resource.data.qty != 0
        && request.resource.data.type in ['purchase', 'sale', 'operationUse', 'adjustment']
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update, delete: if false;
    }

    // ----- suppliers/{supplierId}  (§4.16) --------------------------------
    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && createdByIsCaller();
      allow update: if isAdmin()
        && isNonEmptyString(request.resource.data.name)
        && !changedKeys().hasAny(['createdAt', 'createdBy'])
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- purchases/{purchaseId}  (§4.17): immutable bills ----------------
    match /purchases/{purchaseId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && isNonEmptyString(request.resource.data.supplierId)
        && isNonEmptyString(request.resource.data.billNo)
        && isNonEmptyString(request.resource.data.date)
        && request.resource.data.items is list
        && isNonNegativeInt(request.resource.data.total)
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update, delete: if false;
    }

    // ----- expenses/{expenseId}  (§4.20): purchase expenses in 7A ---------
    // Manual expenses and corrections open in Phase 8.
    match /expenses/{expenseId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.category in ['rent', 'salary', 'utilities', 'supplies', 'purchase', 'payout', 'other']
        && isNonNegativeInt(request.resource.data.amount)
        && isNonEmptyString(request.resource.data.date)
        && request.resource.data.source in ['manual', 'purchase', 'payout']
        && request.resource.data.deleted == false
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      // Phase 8A corrections (decided 6 Nov 2026): a manual expense may be
      // edited; purchase and payout expenses may only be soft deleted.
      allow update: if isAdmin()
        && !changedKeys().hasAny(['source', 'refId', 'branchId', 'createdAt', 'createdBy'])
        && (resource.data.source == 'manual'
            || !changedKeys().hasAny(['category', 'amount', 'date', 'note']))
        && request.resource.data.category in ['rent', 'salary', 'utilities', 'supplies', 'purchase', 'payout', 'other']
        && isNonNegativeInt(request.resource.data.amount)
        && isNonEmptyString(request.resource.data.date)
        && request.resource.data.deleted is bool
        && (request.resource.data.deleted == false
            ? !changedKeys().hasAny(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
            : (isNonEmptyString(request.resource.data.deleteReason)
               && request.resource.data.deletedBy == request.auth.uid))
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- payouts/{payoutId}  (§4.21): Phase 8B ---------------------------
    // Admin creates an unpaid payout whose figures never change afterwards.
    // Mark paid stores the expense written in the same batch; mark unpaid
    // and delete need a reason; a paid payout cannot be deleted.
    function payoutShapeValid(p) {
      return isNonEmptyString(p.doctorId)
        && isNonEmptyString(p.doctorName)
        && isNonEmptyString(p.periodStart)
        && isNonEmptyString(p.periodEnd)
        && p.periodEnd >= p.periodStart
        && isNonNegativeInt(p.salaryAmount)
        && isNonNegativeInt(p.grossFees)
        && isNonNegativeInt(p.discounts)
        && isNonNegativeInt(p.netFees)
        && isNonNegativeInt(p.shareAmount)
        && isNonNegativeInt(p.total)
        && p.total == p.salaryAmount + p.shareAmount
        && p.shareBasis in ['gross', 'net']
        && p.sharePercent is number
        && p.paid is bool
        && p.deleted is bool;
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && payoutShapeValid(request.resource.data)
        && request.resource.data.paid == false
        && request.resource.data.deleted == false
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isAdmin()
        && payoutShapeValid(request.resource.data)
        && !changedKeys().hasAny(['doctorId', 'doctorName', 'periodStart', 'periodEnd',
             'salaryAmount', 'grossFees', 'discounts', 'netFees', 'shareBasis', 'sharePercent',
             'shareAmount', 'total', 'branchId', 'createdAt', 'createdBy'])
        && (request.resource.data.paid == false
            || (isNonEmptyString(request.resource.data.expenseId)
                && request.resource.data.paidBy == request.auth.uid))
        && (!(resource.data.paid == true && request.resource.data.paid == false)
            || isNonEmptyString(request.resource.data.unpaidReason))
        && (request.resource.data.deleted == false
            ? !changedKeys().hasAny(['deleted', 'deletedAt', 'deletedBy', 'deleteReason'])
            : (resource.data.paid == false
               && isNonEmptyString(request.resource.data.deleteReason)
               && request.resource.data.deletedBy == request.auth.uid))
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- dailySummaries/{date}, summaryEvents/{eventId}  (§4.22, §4.23) --
    // Written only by the applyDailySummaryDelta and recomputeDay functions
    // (admin SDK bypasses rules). Admin reads the dashboard; the event
    // ledger is nobody's business.
    match /dailySummaries/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /summaryEvents/{eventId} {
      allow read, write: if false;
    }

    // ----- auditLogs/{logId}  (§4.24): Phase 9 ----------------------------
    // Written only by the audit triggers; Admin reads the viewer.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- sales/{saleId}  (§4.19): Phase 7B ------------------------------
    // Reception and Admin create (the batch also decrements `stock` and
    // writes `stockMovements`); only Admin may void (soft delete with a
    // reason); items and totals never change after creation.
    function saleShapeValid(s) {
      return isNonEmptyString(s.patientName)
        && isNonEmptyString(s.date)
        && s.items is list && s.items.size() > 0
        && isNonNegativeInt(s.subtotal)
        && isNonNegativeInt(s.discountAmount)
        && isNonNegativeInt(s.total)
        && s.total == s.subtotal - s.discountAmount
        && (s.discountAmount == 0 || isNonEmptyString(s.discountReason))
        && s.paymentMethod in ['cash', 'bank', 'jazzcash', 'easypaisa'];
    }

    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create: if isReceptionOrAdmin()
        && saleShapeValid(request.resource.data)
        && request.resource.data.deleted == false
        && inCallerBranch(request.resource.data.branchId)
        && createdByIsCaller();
      allow update: if isAdmin()
        && changedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy', 'deleteReason', 'updatedAt', 'updatedBy'])
        && request.resource.data.deleted == true
        && isNonEmptyString(request.resource.data.deleteReason)
        && request.resource.data.deletedBy == request.auth.uid
        && updatedByIsCaller();
      allow delete: if false;
    }

    // ----- counters/{counterId}  (§4.9): Functions only --------------------
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ----- catch-all: everything not matched above is denied ------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
