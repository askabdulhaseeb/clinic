{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ramzan-clinic-web",
          "appId": "1:662931473606:android:8810e14b48a7a7e45f83c7",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "ramzan-clinic-web",
          "appId": "1:662931473606:ios:8989a58ebf4779805f83c7",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "ramzan-clinic-web",
          "appId": "1:662931473606:ios:8989a58ebf4779805f83c7",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ramzan-clinic-web",
          "configurations": {
            "android": "1:662931473606:android:8810e14b48a7a7e45f83c7",
            "ios": "1:662931473606:ios:8989a58ebf4779805f83c7",
            "macos": "1:662931473606:ios:8989a58ebf4779805f83c7",
            "web": "1:662931473606:web:5c8ab420c6d6bfdb5f83c7",
            "windows": "1:662931473606:web:de9d4bfe1419f4ab5f83c7"
          }
        }
      }
    }
  }
}
